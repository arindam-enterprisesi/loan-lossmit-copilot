# Copy to .env.local. Never commit .env.local.
# Base URL of the FastAPI backend (docker compose). Used by the Next server only: the browser calls this
# app's own /api/proxy, which adds the sign-in token and forwards to this address. So no CORS is involved.
API_URL=http://localhost:8000/api/v1
# Older name for the same setting. Still read when API_URL is not set.
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# true = use src/mocks (no sign-in, no backend); set to false to sign in and call the real API.
NEXT_PUBLIC_USE_MOCKS=true
