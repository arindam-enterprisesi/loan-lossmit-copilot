# Copy to .env and fill in your own keys. Never commit .env.

# --- LLM providers (each person uses their own keys) ---
# Claude API
ANTHROPIC_API_KEY=
# Claude on Amazon Bedrock (D2)
AWS_REGION=
# Use AWS_PROFILE, or the key pair below.
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Google Gemini (D2)
GOOGLE_API_KEY=
# OpenAI (D2)
OPENAI_API_KEY=

# Path to the LLM task config (defaults to backend/config/llm.yaml)
LLM_CONFIG_PATH=

# --- Storage (Abhay) ---
S3_BUCKET=
S3_PREFIX=dev/<your-name>/

# --- Database and jobs (Abhay) ---
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0

# --- Auth (Abhay) ---
JWT_SECRET=change-me
