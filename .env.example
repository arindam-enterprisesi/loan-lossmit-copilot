# Copy to .env and fill in your own keys. Never commit .env.

# --- LLM providers (each person uses their own keys) ---
# Claude API
ANTHROPIC_API_KEY=
# Claude on Amazon Bedrock: region plus either an AWS_PROFILE (SSO) or access keys
AWS_REGION=
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Google Gemini API
GOOGLE_API_KEY=
# OpenAI (also used for embeddings by default; see backend/config/llm.yaml)
OPENAI_API_KEY=

# Path to the LLM task config (defaults to backend/config/llm.yaml)
LLM_CONFIG_PATH=

# --- Storage (Abhay) ---
S3_BUCKET=
S3_PREFIX=dev/<your-name>/

# --- Database and jobs (Abhay) ---
DATABASE_URL=postgresql+asyncpg://copilot:copilot@localhost:5432/copilot
REDIS_URL=redis://localhost:6379/0

# --- Browser access (Abhay) ---
# Origins the frontend runs on, comma-separated. Wildcards are not accepted.
CORS_ORIGINS=http://localhost:3000

# --- Auth (Abhay) ---
JWT_SECRET=change-me
# Password for the seeded demo users (underwriter, lm_specialist, admin); `make seed` uses it.
DEMO_PASSWORD=demo
